---
import { experience } from "../data/portfolio";
import SectionHeading from "./SectionHeading.astro";
---

<section class="experience section" id="experience" aria-labelledby="experience-title">
  <div class="grid-shell">
    <SectionHeading
      id="experience-title"
      index="02"
      eyebrow="Professional Track"
      title="Working where identity"
      italicWord="meets infrastructure."
      traceWord="exp"
    />

    <article class="experience__dossier" data-reveal>
      <!-- Organization Identity & Role Progression -->
      <div class="experience__sidebar">
        <div class="org-identity">
          <h3 class="org-name">{experience.company}</h3>
          <p class="org-role">{experience.role}</p>
          <time class="org-duration">{experience.duration}</time>
        </div>

        <div class="progression-timeline">
          <span class="timeline-title">Career Milestones</span>
          <ol class="timeline-steps">
            {experience.progression.map((step, index) => {
              const [role, dates] = step.split(" · ");
              return (
                <li class="timeline-step">
                  <span class="step-marker" aria-hidden="true">0{index + 1}</span>
                  <div class="step-info">
                    <strong class="step-role">{role}</strong>
                    <span class="step-dates">{dates}</span>
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      </div>

      <!-- Core Architectural Responsibilities -->
      <div class="experience__initiatives">
        <span class="initiatives-title">Selected responsibilities</span>
        <ul class="initiatives-list">
          {experience.responsibilities.map((item, index) => {
            return (
              <li class="initiative-card">
                <div class="initiative-header">
                  <span class="initiative-index">0{index + 1}</span>
                </div>
                <p class="initiative-text">{item}</p>
              </li>
            );
          })}
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  .experience__dossier {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    border-top: 1px solid var(--border-strong);
    padding: clamp(2rem, 4vw, 3.5rem) 0 0;
  }

  /* Sidebar */
  .experience__sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    border-right: 1px solid var(--border-subtle);
    padding-right: clamp(1.5rem, 3vw, 3rem);
  }

  .org-identity {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .org-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    color: var(--text-primary);
    letter-spacing: -0.03em;
  }

  .org-role {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .org-duration {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  /* Timeline */
  .progression-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .timeline-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .timeline-steps {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    padding-left: 1.25rem;
  }

  .timeline-steps::before {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 4px;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-red) 0%, rgba(255, 59, 18, 0.25) 100%);
  }

  .timeline-step {
    position: relative;
    display: flex;
    align-items: flex-start;
  }

  /* Numbered node: the marker is a 20px disc with the mono milestone
     number inside, centred on the same point as the old 10px dot
     (centre x = steps left + 5, on the CSS timeline line). The site
     thread passes through the centre, so the node sits ON the thread. */
  .step-marker {
    position: absolute;
    left: -1.5625rem;
    top: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent-red);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 20px;
    text-align: center;
  }

  .step-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .step-role {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .step-dates {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Initiatives */
  .experience__initiatives {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .initiatives-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
  }

  .initiatives-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .initiative-card {
    border-top: 1px solid var(--border-subtle);
    padding: 1.2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: border-color 0.2s, background 0.2s;
  }

  .initiative-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .initiative-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-red);
  }

  .initiative-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .experience__dossier {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .experience__sidebar {
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
      padding-right: 0;
      padding-bottom: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .initiatives-list {
      grid-template-columns: 1fr;
    }
  }

  /* Mobile shrink (Key 2026-11-09: "Thu nhỏ headline trên mobile cho
     vừa màn hình"): the outlined line "MEETS INFRASTRUCTURE." is
     14.05em wide (advances from the Syne 700 font: MEETS 4053 + space
     241 + INFRASTRUCTURE. 11058, minus 20 gaps of -0.065em
     letter-spacing) and "INFRASTRUCTURE." alone is 10.15em. At the
     3.4rem clamp floor that needs 764px / 552px, far past the ~322px
     available at 390px (390 - 2x18px gutter - 32px heading
     padding-right), so the tail traced off-screen. A vw-sized title
     keeps the whole outlined line on one line: at 390px it renders
     21.45px and the line is 301px; at 320px it is 17.6px and the line
     is 247px against 252px available. Scoped to #experience-title so
     the other headlines keep their size. The trace measures live
     layout (fontSize, docBox, rebuild on resize), so the contours
     rescale with the smaller font and no geometry is cached. */
  @media (max-width: 700px) {
    :global(#experience-title.section-heading__title) {
      font-size: clamp(1rem, 5.5vw, 1.375rem);
    }
  }
</style>
