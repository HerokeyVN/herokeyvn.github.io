// Round 10: cinematic kinetic art installations (static compositions only -
// Phase 2 of Key's round-10 brief; no scroll animation is wired yet).
// The round-9 literal product showcase is deleted outright (phone outlines,
// JSON panels, piano-roll timeline, scene crossfades). The round-9 VERIFIED
// facts survive - see docs/art-direction-round-10.md (design authority) and
// docs/storyboards-round-9.md (fact authority).
//
// Layer model (shared by all three scenes, z-order):
//   bg (0) giant type + faint line-art -> mid (1) translucent 3D structures
//   -> thread-back SVG (2) -> fg (3) focal structure -> thread-front SVG (4)
//   -> labels (5) mono spec annotations. The thread is split across two SVG
//   overlays so it genuinely passes behind foreground structures and in
//   front of background ones (daksh split-z-index technique). Every scene
//   renders its complete final state statically: thread paths are fully
//   drawn (stroke-dasharray none in CSS), lit keys are authored in the
//   markup. src/scripts/project-threads.ts is a static final-state renderer
//   in this round; Phase 4 re-attaches GSAP ScrollTrigger scrub to the same
//   paths and layer hooks (data-layer / data-thread / data-el).

const r1 = (n: number) => Math.round(n * 10) / 10;

// Proper-crossing count between non-adjacent segments of a polyline.
// Build-time diagnostic for the small E2EE seal coil (target >= 2).
type Pt = { x: number; y: number };
const countCrossings = (pts: Pt[]) => {
  const orient = (a: Pt, b: Pt, c: Pt) =>
    Math.sign((b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x));
  let n = 0;
  for (let i = 0; i < pts.length - 1; i++) {
    for (let j = i + 2; j < pts.length - 1; j++) {
      if (i === 0 && j === pts.length - 2) continue;
      const a = pts[i]!;
      const b = pts[i + 1]!;
      const c = pts[j]!;
      const e = pts[j + 1]!;
      const o1 = orient(a, b, c);
      const o2 = orient(a, b, e);
      const o3 = orient(c, e, a);
      const o4 = orient(c, e, b);
      if (o1 !== o2 && o3 !== o4) n++;
    }
  }
  return n;
};

// Small dense coil: one period of a perturbed 3:2 Lissajous figure. Used
// ONLY as the compact seal inside the E2EE core (a seal, not an orbital).
// t runs pi/2..5pi/2 so the loop starts and ends at the leftmost point.
const knotPath = (cx: number, cy: number, A: number, B: number, A2: number, B2: number) => {
  const N = 240;
  const pts: Pt[] = [];
  for (let i = 0; i <= N; i++) {
    const t = Math.PI / 2 + (2 * Math.PI * i) / N;
    pts.push({
      x: r1(cx + A * Math.sin(3 * t) + A2 * Math.cos(7 * t)),
      y: r1(cy + B * Math.sin(2 * t) + B2 * Math.cos(5 * t)),
    });
  }
  let d = "";
  pts.forEach((p, i) => {
    d += (i === 0 ? `M ${p.x} ${p.y}` : ` L ${p.x} ${p.y}`);
  });
  return { d, crossings: countCrossings(pts) };
};

// Smooth curve through points (Catmull-Rom to Bezier). Used for the Sheet
// Store melody line through its staff notes.
type MelodyNote = { x: number; y: number };
const melodyPath = (notes: MelodyNote[]) => {
  const first = notes[0]!;
  let d = `M ${first.x} ${first.y}`;
  for (let i = 0; i < notes.length - 1; i++) {
    const p0 = notes[Math.max(0, i - 1)]!;
    const p1 = notes[i]!;
    const p2 = notes[i + 1]!;
    const p3 = notes[Math.min(notes.length - 1, i + 2)]!;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${r1(c1x)} ${r1(c1y)}, ${r1(c2x)} ${r1(c2y)}, ${p2.x} ${p2.y}`;
  }
  return d;
};

// ---------------------------------------------------------------- E2EE
// Encrypted Transmission. Desktop 900x560: a corridor of 4 receding frames
// (heights narrow monotonically toward the core, each with extruded
// thickness); giant "HELLO" behind it in solid -> outlined -> solid
// letterforms (readable -> protected -> readable); the sealed core (3
// glass plates of distinct materials) at centre-right carries the readable
// message itself, ringed by the red Lissajous seal; the filament enters
// left, coils once inside the core, exits right. Frames 1 and 3 sit in the
// mid layer (thread passes in front of them); frames 2 and 4 sit in the
// foreground layer (thread passes behind them). Mobile 560x560: vertical
// corridor, frames stacked, thread top -> bottom.
const E2EE_COIL = knotPath(756, 280, 52, 46, 6, 5);
console.log(`[motif] E2EE seal coil crossings desktop=${E2EE_COIL.crossings}`);
// Thread segments, desktop (y = 280). Front/back split at the frame edges:
// frame1 x 18-171, frame2 x 216-351, frame3 x 414-549, frame4 x 576-711.
const E2EE_BACK_D = [
  "M 216 280 L 351 280", // behind frame 2
  "M 576 280 L 714 280", // behind frame 4, into the coil
];
const E2EE_FRONT_D = [
  "M 0 280 C 72 272, 144 288, 216 280", // in front of frame 1
  "M 351 280 C 426 288, 501 272, 576 280", // in front of frame 3
  E2EE_COIL.d, // the seal, inside the core
  "M 714 280 C 776 272, 838 288, 900 280", // out of the core to the exit
];
// Thread segments, mobile (x = 280). Frames stacked: f1 y 202-258 (mid),
// f2 y 280-336 (foreground), f3 y 358-414 (mid). The behind-segment runs
// behind f2, the only foreground frame on mobile. The seal is a vertical
// S-coil, so the thread enters at the top and exits at the bottom.
const E2EE_BACK_D_MOBILE = [
  "M 280 280 L 280 336", // behind frame 2
];
const E2EE_FRONT_D_MOBILE = [
  "M 280 0 L 280 280", // in front of the letters and frame 1
  "M 280 336 L 280 420 C 280 445, 262 455, 280 470 C 298 485, 280 495, 280 520", // S-coil seal, gentle weave (round 11: was a tight S with 62.8deg kinks at both ends)
  "M 280 520 L 280 560",
];

// ------------------------------------------------------- Sky Sheet Store
// Living Music Archive. Verified card/detail data from round 9 (live site
// 2026-11-06); see docs/storyboards-round-9.md. The fan is three cards at
// -5deg / 1deg / -2deg; the detail panel floats front-right; the practice
// strip anchors the bottom with the 15-key grid (key 14 lit). The staff
// note heads use the round-9 original 8-note phrase, keys [0,2,4,7,9,11,
// 12,14], mapped to staff height on the right half of the stage.
// Round 11 refinement: fan cards and detail panel are 54% tall so their
// bodies fit (the featured card's stats row used to clip at its bottom
// edge); the staff band (y 352-396) sits in the clear gap below the panels
// (bottom 336) and above the practice strip, so all 8 note heads are
// visible; the descent drops in that same gap, clear of the panel's stats
// and Open Player, and the speed label moved left of the grid so the
// descent clears it too. The featured card is the unmistakable focal
// point: red selection outline, drop shadow, full size, while the back
// cards recede (scale 0.97 / 0.94, deeper fog). Cards and panel carry a
// stepped extruded edge for surface thickness; the final note head is red.
type SheetCard = {
  title: string; artist: string; transcribedBy?: string; uploadedBy: string;
  difficulty: "Hard" | "Insane"; tags: string[];
  bpm: number; notes: number; downloads: number; duration: string;
  lang?: string; tile: "teal" | "purple" | "navy"; featured?: boolean;
};
const SHEET_CARDS: SheetCard[] = [
  {
    title: "Tìm Em", artist: "Hngle Ft. Bảo Anh", transcribedBy: "DTomi",
    uploadedBy: "người lạ thoáng qua", difficulty: "Hard", tags: ["emotional"],
    bpm: 292, notes: 684, downloads: 41, duration: "3:51", lang: "VN",
    tile: "teal", featured: true,
  },
  {
    title: "truoc khi em ton tai", artist: "Anonymous", transcribedBy: "DEX",
    uploadedBy: "Toàn Nguyễn Phạm Dinh", difficulty: "Hard", tags: [],
    bpm: 520, notes: 345, downloads: 47, duration: "1:26", tile: "purple",
  },
  {
    title: "luu nien", artist: "Hakari",
    uploadedBy: "hakari", difficulty: "Insane", tags: [],
    bpm: 750, notes: 953, downloads: 42, duration: "3:08", tile: "navy",
  },
];
const SHEET_STATS = [
  { value: "292", label: "BPM" },
  { value: "3:51", label: "Duration" },
  { value: "684", label: "Note Count" },
  { value: "2.96", label: "Notes/Sec" },
  { value: "15/15", label: "Unique Keys" },
  { value: "89", label: "Chord Count" },
];
const SHEET_PHRASE_KEYS = [0, 2, 4, 7, 9, 11, 12, 14];
// Staff notes, desktop (1440x560): x from 56% to 94%, y from 396 (key 0,
// bottom staff line) to 352 (key 14, top staff line). Round 11 refinement:
// the staff band (y 352-396) sits in the clear gap below the fan/detail
// bottoms (336) and above the practice strip (437), so every note head is
// visible instead of hiding behind the detail panel.
const SHEET_NOTES: MelodyNote[] = SHEET_PHRASE_KEYS.map((key, i) => ({
  x: r1(806 + (i / 7) * 547),
  y: r1(396 - (key / 14) * 44),
}));
const SHEET_MELODY = melodyPath(SHEET_NOTES);
// Staff notes, mobile (560x560): one row above the practice grid,
// y from 380 (key 0) to 350 (key 14).
const SHEET_NOTES_MOBILE: MelodyNote[] = SHEET_PHRASE_KEYS.map((key, i) => ({
  x: r1(56 + (i / 7) * 448),
  y: r1(380 - (key / 14) * 30),
}));
const SHEET_MELODY_MOBILE = melodyPath(SHEET_NOTES_MOBILE);

// --------------------------------------------------------- Sky Auto Piano
// Kinetic Playback Machine. Three terraced tiers in perspective (back
// YUIOP, mid HJKL;, front NM,./). Only the two verified mappings are shown
// (1Key3 -> H, 1Key7 -> L): H pressed (translated down, sunk dark red),
// L held (bright red, glow ring, sustain bar below the key). The belt runs
// along the mid tier, dips onto H, passes under a raised bridge bar, dips
// onto L, exits right.
// Round 11 workstream B refinement: keys are physical objects with a
// top-light/inset-shadow front face and per-tier materials (back tier
// darkest, front tier lightest); tiers carry a stepped extruded edge like
// the E2EE frames; the giant key-letter field tells the story in
// solid -> OUTLINED -> solid rows (the played HJKL; row is the outlined
// one) and fades out toward the machine instead of hard-clipping behind
// it. The meaningless hairline rules and faint background circle are
// removed; the rails are a solid frame with rivets, not a barcode.
const PIANO_KEYS = ["Y", "U", "I", "O", "P", "H", "J", "K", "L", ";", "N", "M", ",", ".", "/"];
const PIANO_TIERS = [
  { row: 0, keys: ["Y", "U", "I", "O", "P"] },
  { row: 1, keys: ["H", "J", "K", "L", ";"] },
  { row: 2, keys: ["N", "M", ",", ".", "/"] },
];
// Belt, desktop (y = 250, mid-tier level). H centre x ~330, L centre x
// ~654. The bridge bar spans x 420-540 at y 240-258; the belt passes under
// it (thread-back), and dips onto H and L (thread-front).
const PIANO_BACK_D = ["M 408 250 L 552 250"];
const PIANO_FRONT_D = [
  "M 0 250 L 280 250 C 305 250, 305 284, 330 284 C 355 284, 355 250, 380 250 L 408 250",
  "M 552 250 L 622 250 C 647 250, 647 284, 672 284 C 697 284, 697 250, 722 250 L 900 250",
];
// Belt, mobile (560x560): down the left edge, across the mid tier (dips
// onto H at x 90 and L at x 378, y 176-196), then down the right edge,
// passing behind the front tier (y 258-342) before exiting at the bottom.
const PIANO_BACK_D_MOBILE = ["M 500 193 L 500 320"];
const PIANO_FRONT_D_MOBILE = [
  "M 30 0 L 30 135 C 30 150, 40 163, 55 163 C 72 163, 72 191, 90 191 C 108 191, 108 163, 125 163 L 340 163 C 357 163, 357 191, 375 191 C 393 191, 393 163, 410 163 L 470 163 C 490 163, 500 173, 500 193",
  "M 500 320 L 500 560",
];
