      </div>
      <span class="piano-bridge" data-el="piano-bridge" aria-hidden="true"></span>
      <div class="piano-plate" data-el="piano-plate">
        <span class="mono-caption">ILLUSTRATIVE MECHANISM — THE APP SENDS KEYSTROKES; IT PLAYS NO AUDIO</span>
      </div>
    </div>

    <svg class="project-thread-svg project-thread-svg--front project-thread-svg--desktop" data-layer="thread-front" data-variant="desktop" viewBox="0 0 900 560" aria-hidden="true">
      {PIANO_FRONT_D.map((d) => (<path class="project-thread-path" d={d}></path>))}
      <circle class="project-thread-dot project-thread-dot--end" cx="896" cy="250" r="4"></circle>
    </svg>
    <svg class="project-thread-svg project-thread-svg--front project-thread-svg--mobile" data-layer="thread-front" data-variant="mobile" viewBox="0 0 560 560" aria-hidden="true">
      {PIANO_FRONT_D_MOBILE.map((d) => (<path class="project-thread-path" d={d}></path>))}
      <circle class="project-thread-dot project-thread-dot--end" cx="500" cy="556" r="4"></circle>
    </svg>

    <div class="layer layer--labels" data-layer="labels">
      <span class="fig-label" data-el="piano-fig">FIG. 03 · PLAYBACK MACHINE</span>
      <span class="mono-label" data-el="piano-mapping">1Key3 → H · 1Key7 → L</span>
      <span class="mono-label" data-el="piano-speed-label">SPEED 1.0× · 0.1×–5×</span>
      <span class="mono-label" data-el="piano-lp-label">LONG-PRESS ON — SUSTAINED NOTES HOLD</span>
      <span class="mono-label" data-el="piano-song-label">song.json · 0:10 / 0:12</span>
    </div>
  </div>
)}

<style>
  /* The stage keeps the motif viewBox aspect, so the thread fills the stage
     exactly. Panoramic keeps its own. The stage is a query container: scene
     type and spacing use cqw so the DOM scenes scale with the stage exactly
     like the SVG viewBox does. */
  .project-thread-stage { position: relative; aspect-ratio: 900 / 560; overflow: hidden; border: 1px solid var(--border-subtle); background: #060608; container-type: inline-size; }
  .project-thread-stage--panoramic { aspect-ratio: 1440 / 560; }

  /* Shared layer stack (z-order): bg 0, mid 1, thread-back 2, fg 3,
     thread-front 4, labels 5. The thread is split across two SVG overlays
     so it genuinely passes behind foreground structures and in front of
     background ones. */
  .layer { position: absolute; inset: 0; }
  .layer--bg { z-index: 0; }
  .layer--mid { z-index: 1; }
  .layer--fg { z-index: 3; }
  .layer--labels { z-index: 5; pointer-events: none; }
  .project-thread-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .project-thread-svg--back { z-index: 2; }
  .project-thread-svg--front { z-index: 4; }
  .project-thread-svg--mobile { display: none; }
  /* Round 10 is static: the thread is fully drawn by default. Phase 4
     re-attaches scrub to these same paths. */
  .project-thread-path { fill: none; stroke: var(--accent-red); stroke-width: 2px; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; visibility: visible; stroke-dasharray: none; }
  .project-thread-dot { fill: #060608; stroke: #ffffff; stroke-opacity: 0.4; stroke-width: 1.5px; }
  .project-thread-dot--end { fill: var(--accent-red); stroke: var(--accent-red); stroke-opacity: 1; }
  .fig-label { position: absolute; color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; font-size: 1.22cqw; letter-spacing: 0.12em; }
  .mono-label { position: absolute; color: var(--text-muted); font-family: var(--font-mono); font-size: 10px; font-size: 1.11cqw; line-height: 1.5; letter-spacing: 0.06em; }
  .mono-caption { position: absolute; color: var(--text-muted); font-family: var(--font-mono); font-size: 11px; font-size: 1.22cqw; line-height: 1.5; letter-spacing: 0.02em; }

  /* ---- E2EE: Encrypted Transmission ---- */
  /* Round 11 refinement: the giant word now tells readable -> protected
     -> readable with solid vs OUTLINED letterforms (all five letters stay
     recognisable; the old clipped/rotated fragments vanished behind the
     frames). The readable message lives inside the sealed core itself. */
  .e2ee-word { position: absolute; left: 4%; top: 30%; width: 92%; display: flex; justify-content: space-between; font-family: var(--font-display); font-weight: 800; font-size: 17cqw; line-height: 1; color: var(--text-primary); }
  .e2ee-letter--read { opacity: 0.62; }
  .e2ee-letter--frag { color: transparent; -webkit-text-stroke: 2px rgba(239, 237, 230, 0.55); }
  .e2ee-letter--frag-a { opacity: 0.5; }
  .e2ee-letter--frag-b { opacity: 0.65; }
  /* Frames form one receding corridor: heights narrow monotonically toward
     the core while every frame stays centred on the thread (y 50%), and a
     stepped bottom-right shadow gives each frame visible extruded
     thickness instead of a flat outline. */
  .e2ee-frame { position: absolute; border: 1px solid rgba(239, 237, 230, 0.14); background: rgba(6, 6, 8, 0.92); border-radius: 4px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 10px 12px 0 -4px #050506, 10px 12px 0 -3px rgba(239, 237, 230, 0.1); }
  .e2ee-frame--1 { left: 2%; top: 22%; width: 17%; height: 56%; transform: perspective(1100px) rotateY(-8deg) translateX(var(--frame-x, 0px)); }
  .e2ee-frame--2 { left: 24%; top: 26%; width: 15%; height: 48%; transform: perspective(1100px) rotateY(-8deg) translateX(var(--frame-x, 0px)); }
  .e2ee-frame--3 { left: 46%; top: 30%; width: 15%; height: 40%; transform: perspective(1100px) rotateY(-8deg) translateX(var(--frame-x, 0px)); }
  .e2ee-frame--4 { left: 64%; top: 34%; width: 15%; height: 32%; transform: perspective(1100px) rotateY(-8deg) translateX(var(--frame-x, 0px)); }
  .e2ee-filament { position: absolute; left: 4%; width: 92%; height: 1px; background: rgba(255, 255, 255, 0.18); }
  .e2ee-core { position: absolute; left: 76%; top: 30%; width: 18%; height: 40%; }
  /* Plates are three distinct materials: matte back, mid-tone middle,
     front glass with a top-light gradient and a drop shadow that lifts it
     off the stack. The sealed message sits on the front plate with the
     red seal ring and the Lissajous coil (thread-front SVG) over it. */
  .e2ee-plate { position: absolute; inset: 0; border: 1px solid rgba(239, 237, 230, 0.1); border-radius: 6px; }
  .e2ee-plate--back { background: #0a0a0d; }
  .e2ee-plate--mid { transform: translate(4%, 6%); background: rgba(20, 20, 24, 0.85); }
  .e2ee-plate--front { transform: translate(8%, 12%); background: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.01) 55%); border-color: var(--border-highlight); box-shadow: 0 16px 28px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.18); }
  .e2ee-seal-ring { position: absolute; left: 50%; top: 50%; width: 34%; aspect-ratio: 1; transform: translate(-50%, -50%) scale(var(--ring-scale, 1)); border: 1.5px solid rgba(255, 60, 26, 0.55); border-radius: 50%; }
  .e2ee-core-message { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-family: var(--font-display); font-weight: 800; font-size: 3.4cqw; letter-spacing: 0.08em; line-height: 1; color: var(--text-primary); text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6); white-space: nowrap; }
  .e2ee-relay { position: absolute; left: 52%; top: 82%; width: 12%; height: 10%; border: 1px solid rgba(239, 237, 230, 0.2); border-radius: 4px; background: #0a0a0d repeating-linear-gradient(0deg, transparent 0 10px, rgba(239, 237, 230, 0.22) 10px 11px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.14); }
  .e2ee-relay::before { content: ""; position: absolute; right: 8%; top: 18%; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-red); opacity: var(--led-o, 1); }

  [data-el="e2ee-fig"] { left: 2%; top: 3%; }
  [data-el="e2ee-signal-label"] { left: 74%; top: 74%; width: 24%; }
  [data-el="e2ee-noise-label"] { left: 56%; top: 8%; width: 30%; }
  [data-el="e2ee-relay-label"] { left: 50%; top: 93%; width: 16%; text-align: center; }

  /* ---- Sheet Store: Living Music Archive ---- */
  /* Vertical spine: the horizontal giant word was hidden behind the fan
     and the detail panel, so SHEETS runs upright down the left gutter
     instead, where it is actually visible. */
  .sheet-giant { position: absolute; left: 0.5%; top: 8%; height: 56%; writing-mode: vertical-rl; text-orientation: upright; font-family: var(--font-display); font-weight: 800; font-size: 3.2cqw; line-height: 1; letter-spacing: 0.15em; color: rgba(239, 237, 230, 0.05); -webkit-text-stroke: 1px rgba(239, 237, 230, 0.38); white-space: nowrap; }
  .sheet-bg-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sheet-bg-svg--mobile { display: none; }
  .sheet-staff-line { stroke: rgba(255, 255, 255, 0.12); stroke-width: 1; }
  .sheet-note-head { fill: rgba(255, 255, 255, var(--note-a, 0.35)); transform-box: fill-box; transform-origin: center; transform: rotate(-15deg); }
  .sheet-note-head--final { fill: var(--accent-red); }
  .sheet-fan { position: absolute; inset: 0; }
  .sheet-deck { display: none; }
  /* Cards are physical sheets, not flat UI rectangles: a stepped
     extruded edge (dark slab + hairline) gives each one visible surface
     thickness, and a soft drop shadow seats it on the deck. The featured
     card is the focal point: full size, a red selection outline (the
     thread rests on its tile), and the strongest shadow; the back cards
     recede with a smaller scale and a deeper fog veil. */
  .sheet-card { position: absolute; display: flex; flex-direction: column; background: #ffffff; border-radius: 12px; border-radius: 0.83cqw; overflow: hidden; color: #111827; text-align: left; min-width: 0; width: 20%; height: 54%; box-shadow: 10px 12px 0 -4px #050506, 10px 12px 0 -3px rgba(239, 237, 230, 0.1), 0 18px 36px rgba(0, 0, 0, 0.45); }
  .sheet-card--fan-0 { left: 41%; top: 6%; transform: translateY(var(--fan-y, 0px)) rotate(var(--fan-rot, -2deg)); z-index: 3; box-shadow: 0 0 0 2px rgba(255, 60, 26, 0.9), 10px 12px 0 -4px #050506, 10px 12px 0 -3px rgba(239, 237, 230, 0.1), 0 24px 48px rgba(0, 0, 0, 0.55); }
  .sheet-card--fan-1 { left: 23%; top: 13%; transform: translateY(var(--fan-y, 0px)) rotate(var(--fan-rot, 1deg)) scale(var(--fan-scale, 0.97)); transform-origin: 50% 100%; z-index: 2; }
  .sheet-card--fan-1::after, .sheet-card--fan-2::after { content: ""; position: absolute; inset: 0; background: rgba(6, 6, 8, 0.3); z-index: 1; pointer-events: none; }
  .sheet-card--fan-2 { left: 5%; top: 20%; transform: translateY(var(--fan-y, 0px)) rotate(var(--fan-rot, -5deg)) scale(var(--fan-scale, 0.94)); transform-origin: 50% 100%; z-index: 1; }
  .sheet-card--fan-2::after { background: rgba(6, 6, 8, 0.5); }
  .sheet-card--featured .sheet-card__title { font-size: 18px; font-size: 1.25cqw; }
  .sheet-card__cover { position: relative; flex: 0 0 44%; overflow: hidden; }
  .sheet-card__cover--teal { background: linear-gradient(135deg, #14b8a6, #0d9488); }
  .sheet-card__cover--purple { background: linear-gradient(135deg, #a855f7, #7c3aed); }
  .sheet-card__cover--navy { background: linear-gradient(135deg, #1e293b, #0f172a); }
  .sheet-card__cover::after { content: ""; position: absolute; inset: 0; background-image: repeating-linear-gradient(0deg, transparent 0 16px, rgba(255, 255, 255, 0.13) 16px 17px), repeating-linear-gradient(90deg, transparent 0 16px, rgba(255, 255, 255, 0.06) 16px 17px); }
  .sheet-card__notes { position: absolute; left: 38%; top: 34%; color: #ffffff; opacity: 0.55; font-size: 34px; font-size: 2.36cqw; z-index: 1; }
  .sheet-card__notes--small { left: 12%; top: 62%; font-size: 18px; font-size: 1.25cqw; opacity: 0.35; }
  /* The detail cover's notes sit low so the entry hairpin (which runs
     flat at y~68 across the cover's top band, then hooks down to the play
