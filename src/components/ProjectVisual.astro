  .sheet-practice__grid { position: absolute; right: 0; top: 12%; width: 30%; height: 76%; display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; gap: 0.42cqw; }
  .sheet-key { display: flex; align-items: center; justify-content: center; background: #141416; border: 1px solid var(--border-strong); border-bottom: 2px solid #000000; border-radius: 4px; border-radius: 0.28cqw; font-family: var(--font-mono); font-size: 13px; font-size: 0.9cqw; color: var(--text-muted); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08); }
  .sheet-key.is-lit { background: var(--accent-red); border-color: var(--accent-red); border-bottom-color: #7f1d0d; color: #fff; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 2px 8px rgba(255, 60, 26, 0.35); }

  [data-el="sheet-fig"] { left: 2%; top: 2%; }
  [data-el="sheet-trending-label"] { left: 41%; top: 3%; }
  [data-el="sheet-data-label"] { left: 2%; bottom: 2%; }

  /* ---- Piano: Kinetic Playback Machine ---- */
  /* Round 11 workstream B: the giant key-letter field tells solid ->
     OUTLINED -> solid (the played HJKL; row is the outlined one, like
     E2EE's solid -> outlined -> solid HELLO) and fades out toward the
     machine with a right-edge mask instead of hard-clipping behind the
     tiers. The hairline rules and the faint background circle are gone:
     they crossed the letters and read as unrelated scribbles. */
  .piano-giant { position: absolute; left: 4%; top: 5%; width: 55%; display: flex; flex-direction: column; gap: 2cqw; font-family: var(--font-display); font-weight: 800; font-size: 8.5cqw; line-height: 1.05; letter-spacing: 0.02em; white-space: nowrap; -webkit-mask-image: linear-gradient(90deg, #000 45%, transparent 88%); mask-image: linear-gradient(90deg, #000 45%, transparent 88%); }
  .piano-giant__row--solid { color: rgba(239, 237, 230, 0.1); }
  .piano-giant__row--outline { color: transparent; -webkit-text-stroke: 1.5px rgba(239, 237, 230, 0.34); }
  .piano-giant__row--dim { color: rgba(239, 237, 230, 0.05); }
  /* Rails are a solid machine frame with rivets, not a striped barcode:
     one dark body, a hairline border, five rivet dots down each rail. */
  .piano-rail { position: absolute; top: 12%; width: 3%; height: 64%; border: 1px solid rgba(239, 237, 230, 0.12); background-color: #0b0b0e; background-image: radial-gradient(circle at 50% 50%, rgba(239, 237, 230, 0.38) 1.5px, transparent 2.2px); background-size: 100% 20%; background-repeat: repeat-y; }
  .piano-rail--left { left: 2%; }
  .piano-rail--right { right: 2%; }
  .piano-gauge { position: absolute; left: 10%; top: 92%; width: 80%; height: 2px; background: rgba(255, 255, 255, 0.1); }
  .piano-gauge__fill { display: block; position: relative; height: 100%; width: 88%; background: var(--accent-red); }
  /* Playhead dot at the fill's end: the gauge marks "now" (0:10 of 0:12),
     not just a static bar. */
  .piano-gauge__fill::after { content: ""; position: absolute; right: -4px; top: 50%; width: 8px; height: 8px; transform: translateY(-50%); border-radius: 50%; background: var(--accent-red); border: 2px solid #060608; }
  .piano-machine { position: absolute; left: 28%; top: 14%; width: 68%; height: 66%; }
  /* Tiers carry a stepped extruded edge (dark slab + hairline + drop
     shadow), the same thickness language as the E2EE frames and the
     Sheet Store cards, so each tier reads as a solid step of the
     ziggurat instead of a flat floating rectangle. */
