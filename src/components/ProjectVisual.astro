---
import type { Project } from "../data/portfolio";

interface Props { project: Project; }
const { project } = Astro.props;

// Motif path builders. They run at build time and return deterministic
// `d` strings; the scroll drawing itself lives in src/scripts/project-threads.ts.
// Round 8 redesign: the round-7 motifs read as sparse abstract geometry on
// big empty stages, so each motif now fills ~85% of its stage and draws a
// recognizable story element (tangled knot, staff + vinyl, piano keyboard).

const r1 = (n: number) => Math.round(n * 10) / 10;

// Archimedean spiral, radius r0 to r1 over `turns` turns, sampled every 6 degrees.
const spiralPath = (cx: number, cy: number, r0: number, rEnd: number, turns: number) => {
  const totalAngle = turns * 2 * Math.PI;
  const steps = Math.round(totalAngle / (Math.PI / 30));
  let d = "";
  for (let i = 0; i <= steps; i++) {
    const angle = (totalAngle * i) / steps;
    const r = r0 + ((rEnd - r0) * i) / steps;
    const x = r1(cx + r * Math.cos(angle));
    const y = r1(cy + r * Math.sin(angle));
    d += (i === 0 ? `M ${x} ${y}` : ` L ${x} ${y}`);
  }
  return d;
};

// Proper-crossing count between non-adjacent segments of a polyline.
// Build-time diagnostic for the E2EE knot density (target 8-10 crossings).
type Pt = { x: number; y: number };
const countCrossings = (pts: Pt[]) => {
  const orient = (a: Pt, b: Pt, c: Pt) =>
    Math.sign((b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x));
  let n = 0;
  for (let i = 0; i < pts.length - 1; i++) {
    for (let j = i + 2; j < pts.length - 1; j++) {
      if (i === 0 && j === pts.length - 2) continue;
      const a = pts[i]!;
      const b = pts[i + 1]!;
      const c = pts[j]!;
      const e = pts[j + 1]!;
      const o1 = orient(a, b, c);
      const o2 = orient(a, b, e);
      const o3 = orient(c, e, a);
      const o4 = orient(c, e, b);
      if (o1 !== o2 && o3 !== o4) n++;
    }
  }
  return n;
};

// Dense tangled knot: one period of a perturbed 3:2 Lissajous figure.
// t runs pi/2..5pi/2 so the loop starts and ends at the leftmost point
// (cx-A, cy); the exit straight then runs from there through the ball to B,
// like a thread passing through a ball of yarn. The perturbation breaks the
// figure's exact symmetry so the loops read as a tangle, not a spirograph.
// Returns the path and its self-crossing count (7, plus the through-line).
const knotPath = (cx: number, cy: number, A: number, B: number, A2: number, B2: number) => {
  const N = 240;
  const pts: Pt[] = [];
  for (let i = 0; i <= N; i++) {
    const t = Math.PI / 2 + (2 * Math.PI * i) / N;
    pts.push({
      x: r1(cx + A * Math.sin(3 * t) + A2 * Math.cos(7 * t)),
      y: r1(cy + B * Math.sin(2 * t) + B2 * Math.cos(5 * t)),
    });
  }
  let d = "";
  pts.forEach((p, i) => {
    d += (i === 0 ? `M ${p.x} ${p.y}` : ` L ${p.x} ${p.y}`);
  });
  return { d, crossings: countCrossings(pts) };
};

// Smooth melody through note points (Catmull-Rom to Bezier). Points flagged
// `loop` get a small note-head loop (near-full circle arc) drawn on the spot.
type MelodyNote = { x: number; y: number; loop?: boolean };
const melodyPath = (notes: MelodyNote[]) => {
  const first = notes[0]!;
  let d = `M ${first.x} ${first.y}`;
  for (let i = 0; i < notes.length - 1; i++) {
    const p0 = notes[Math.max(0, i - 1)]!;
    const p1 = notes[i]!;
    const p2 = notes[i + 1]!;
    const p3 = notes[Math.min(notes.length - 1, i + 2)]!;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${r1(c1x)} ${r1(c1y)}, ${r1(c2x)} ${r1(c2y)}, ${p2.x} ${p2.y}`;
    if (p2.loop) d += ` a 13 13 0 1 1 0.01 0`;
  }
  return d;
};

// Piano keyboard, drawn in one continuous serpentine: right edge up, then
// alternating top/bottom runs so every key separator is drawn once and the
// path ends at the top-left corner, ready for the steps.
const keyboardPath = (x0: number, x1: number, yTop: number, yBottom: number, keys: number) => {
  const w = (x1 - x0) / keys;
  let d = `M ${x1} ${yBottom} L ${x1} ${yTop}`;
  let x = x1;
  let top = true;
  for (let k = 0; k < keys; k++) {
    x -= w;
    d += ` L ${r1(x)} ${top ? yTop : yBottom} L ${r1(x)} ${top ? yBottom : yTop}`;
    top = !top;
  }
  return d;
};

// 01 E2EE: short straight from A, big dense knot centrepiece, straight
// to B. The knot is one period of a perturbed 3:2 Lissajous figure; the
// straight to B runs through the ball from the loop's return point.
const E2EE_KNOT = knotPath(450, 280, 210, 190, 15, 12);
const E2EE_KNOT_MOBILE = knotPath(280, 280, 140, 135, 10, 8);
console.log(`[motif] E2EE knot crossings desktop=${E2EE_KNOT.crossings} mobile=${E2EE_KNOT_MOBILE.crossings}`);
const E2EE_D = `M 60 280 L 240 280 ${E2EE_KNOT.d.replace(/^M [\d.]+ [\d.]+/, "")} L 840 280`;
const E2EE_D_MOBILE = `M 30 280 L 140 280 ${E2EE_KNOT_MOBILE.d.replace(/^M [\d.]+ [\d.]+/, "")} L 530 280`;

// 02 Sky Sheet Store: melody on a faint staff, then a big vinyl-record
// spiral. Staff lines and record outlines are dim background guides,
// not the thread; the red thread draws the melody, the spiral, the exit.
const SHEET_STAFF_Y = [190, 235, 280, 325, 370];
const SHEET_STAFF_D = SHEET_STAFF_Y.map((y) => `M 60 ${y} H 860`).join(" ");
const SHEET_MELODY = melodyPath([
  { x: 60, y: 280 },
  { x: 140, y: 235 },
  { x: 205, y: 190, loop: true },
  { x: 280, y: 280 },
  { x: 355, y: 325, loop: true },
  { x: 430, y: 235 },
  { x: 500, y: 190, loop: true },
  { x: 575, y: 280 },
  { x: 650, y: 325, loop: true },
  { x: 725, y: 235 },
  { x: 820, y: 280 },
]);
const SHEET_SPIRAL = spiralPath(1150, 280, 8, 195, 5).replace(/^M [\d.]+ [\d.]+/, "");
const SHEET_D = `${SHEET_MELODY} C 950 250, 1050 310, 1158 280${SHEET_SPIRAL} L 1400 330`;

// Mobile Sheet Store stacks the composition: staff on top, record below.
const SHEET_STAFF_Y_MOBILE = [120, 150, 180, 210, 240];
const SHEET_STAFF_D_MOBILE = SHEET_STAFF_Y_MOBILE.map((y) => `M 40 ${y} H 520`).join(" ");
const SHEET_MELODY_MOBILE = melodyPath([
  { x: 40, y: 180 },
  { x: 110, y: 150 },
  { x: 170, y: 120, loop: true },
  { x: 240, y: 180 },
  { x: 310, y: 210, loop: true },
  { x: 380, y: 150 },
  { x: 450, y: 180, loop: true },
  { x: 520, y: 180 },
]);
const SHEET_SPIRAL_MOBILE = spiralPath(280, 410, 8, 105, 4).replace(/^M [\d.]+ [\d.]+/, "");
const SHEET_D_MOBILE = `${SHEET_MELODY_MOBILE} C 520 260, 420 340, 288 410${SHEET_SPIRAL_MOBILE} L 520 470`;

// 03 Sky Auto Piano: keyboard, then tall bouncing steps that dip down to
// press three keys, then a large arpeggio zigzag to the top-right corner.
const PIANO_KEYS = keyboardPath(60, 840, 430, 520, 12);
const PIANO_STEPS =
  "L 60 300 L 160 300 L 160 430 L 160 210 L 260 210 L 260 430 L 260 120 L 360 120 L 360 430 L 360 60";
const PIANO_ARP = "L 430 150 L 500 60 L 570 150 L 640 60 L 710 150 L 780 60 L 850 150 L 880 70";
const PIANO_D = `${PIANO_KEYS} ${PIANO_STEPS} ${PIANO_ARP}`;
const PIANO_DOTS = [
  { cx: 160, cy: 430 },
  { cx: 260, cy: 430 },
  { cx: 360, cy: 430 },
];

const PIANO_KEYS_MOBILE = keyboardPath(30, 530, 430, 520, 10);
const PIANO_STEPS_MOBILE =
  "L 30 300 L 110 300 L 110 430 L 110 210 L 190 210 L 190 430 L 190 120 L 270 120 L 270 430 L 270 60";
const PIANO_ARP_MOBILE = "L 330 150 L 390 60 L 450 150 L 510 60 L 540 110";
const PIANO_D_MOBILE = `${PIANO_KEYS_MOBILE} ${PIANO_STEPS_MOBILE} ${PIANO_ARP_MOBILE}`;
const PIANO_DOTS_MOBILE = [
  { cx: 110, cy: 430 },
  { cx: 190, cy: 430 },
  { cx: 270, cy: 430 },
];
---

{project.slug === "fb-messenger-e2ee" && (
  <div class="project-thread-stage" data-project-thread-stage>
    <svg class="project-thread-svg project-thread-svg--desktop" data-project-thread="fb-messenger-e2ee" data-variant="desktop" viewBox="0 0 900 560" aria-hidden="true">
      <path class="project-thread-path" d={E2EE_D}></path>
      <circle class="project-thread-node" data-thread-node="a" cx="60" cy="280" r="7"></circle>
      <circle class="project-thread-node" data-thread-node="b" cx="840" cy="280" r="7"></circle>
      <text class="project-thread-label" x="60" y="256" text-anchor="middle">A</text>
      <text class="project-thread-label" x="840" y="256" text-anchor="middle">B</text>
    </svg>
    <svg class="project-thread-svg project-thread-svg--mobile" data-project-thread="fb-messenger-e2ee" data-variant="mobile" viewBox="0 0 560 560" aria-hidden="true">
      <path class="project-thread-path" d={E2EE_D_MOBILE}></path>
      <circle class="project-thread-node" data-thread-node="a" cx="30" cy="280" r="7"></circle>
      <circle class="project-thread-node" data-thread-node="b" cx="530" cy="280" r="7"></circle>
      <text class="project-thread-label" x="30" y="256" text-anchor="middle">A</text>
      <text class="project-thread-label" x="530" y="256" text-anchor="middle">B</text>
    </svg>
    <span class="visual-label visual-label--top">Signal Protocol / Key state</span>
    <span class="visual-label visual-label--top-right">Noise transport / Encrypted flow</span>
    <span class="phase-caption phase-caption--left">Plaintext</span>
    <span class="phase-caption phase-caption--center">Encrypted</span>
    <span class="phase-caption phase-caption--right">Decrypted</span>
  </div>
)}

{project.slug === "sky-sheet-store" && (
  <div class="project-thread-stage project-thread-stage--panoramic" data-project-thread-stage>
    <svg class="project-thread-svg project-thread-svg--desktop" data-project-thread="sky-sheet-store" data-variant="desktop" viewBox="0 0 1440 560" aria-hidden="true">
      <path class="project-thread-guide" d={SHEET_STAFF_D}></path>
      <circle class="project-thread-guide" cx="1150" cy="280" r="225"></circle>
      <circle class="project-thread-guide" cx="1150" cy="280" r="140"></circle>
      <circle class="project-thread-guide-dot" cx="1150" cy="280" r="5"></circle>
      <path class="project-thread-path" d={SHEET_D}></path>
    </svg>
    <svg class="project-thread-svg project-thread-svg--mobile" data-project-thread="sky-sheet-store" data-variant="mobile" viewBox="0 0 560 560" aria-hidden="true">
      <path class="project-thread-guide" d={SHEET_STAFF_D_MOBILE}></path>
      <circle class="project-thread-guide" cx="280" cy="410" r="115"></circle>
      <circle class="project-thread-guide" cx="280" cy="410" r="70"></circle>
      <circle class="project-thread-guide-dot" cx="280" cy="410" r="4"></circle>
      <path class="project-thread-path" d={SHEET_D_MOBILE}></path>
    </svg>
    <span class="visual-label visual-label--top">02 / Live platform</span>
    <span class="visual-label visual-label--top-right">Discovery · Sharing · Practice</span>
  </div>
)}

{project.slug === "sky-auto-piano" && (
  <div class="project-thread-stage" data-project-thread-stage>
    <svg class="project-thread-svg project-thread-svg--desktop" data-project-thread="sky-auto-piano" data-variant="desktop" viewBox="0 0 900 560" aria-hidden="true">
      <path class="project-thread-path" d={PIANO_D}></path>
      {PIANO_DOTS.map((dot) => (
        <circle class="project-thread-node" data-thread-dot cx={dot.cx} cy={dot.cy} r="6"></circle>
      ))}
    </svg>
    <svg class="project-thread-svg project-thread-svg--mobile" data-project-thread="sky-auto-piano" data-variant="mobile" viewBox="0 0 560 560" aria-hidden="true">
      <path class="project-thread-path" d={PIANO_D_MOBILE}></path>
      {PIANO_DOTS_MOBILE.map((dot) => (
        <circle class="project-thread-node" data-thread-dot cx={dot.cx} cy={dot.cy} r="6"></circle>
      ))}
    </svg>
    <span class="visual-label visual-label--top">Desktop playback automation</span>
  </div>
)}

<style>
  /* The stage keeps the motif viewBox aspect, so the thread fills the stage
     instead of floating in a tall letterboxed band. Panoramic keeps its own. */
  .project-thread-stage { position: relative; aspect-ratio: 900 / 560; overflow: hidden; border: 1px solid var(--border-subtle); background: #060608; }
  .project-thread-stage--panoramic { aspect-ratio: 1440 / 560; }
  .project-thread-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .project-thread-svg--mobile { display: none; }
  .project-thread-path { fill: none; stroke: var(--accent-red); stroke-width: 2px; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .project-thread-node { fill: var(--accent-red); }
  /* Dim background guides (staff lines, record outlines): not the thread. */
  .project-thread-guide { fill: none; stroke: #ffffff; stroke-opacity: 0.16; stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .project-thread-guide-dot { fill: #ffffff; fill-opacity: 0.22; }
  .project-thread-label { fill: var(--text-muted); font-family: var(--font-mono); font-size: 15px; font-weight: 500; letter-spacing: 0.08em; }
  .visual-label { position: absolute; z-index: 2; color: var(--text-muted); font: 400 0.62rem/1.4 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .visual-label--top { top: 1.5rem; left: 1.5rem; }
  .visual-label--top-right { top: 1.5rem; right: 1.5rem; }
  .visual-label--bottom { right: 1.5rem; bottom: 1.5rem; }
  /* E2EE phase legend under the motif. */
  .phase-caption { position: absolute; bottom: 0.75rem; z-index: 2; color: var(--text-muted); font: 400 0.62rem/1.4 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .phase-caption--left { left: 1.5rem; }
  .phase-caption--center { left: 50%; transform: translateX(-50%); color: var(--accent-red); }
  .phase-caption--right { right: 1.5rem; }

  @media (max-width: 700px) {
    .project-thread-stage { aspect-ratio: 1 / 1; }
    .project-thread-svg--desktop { display: none; }
    .project-thread-svg--mobile { display: block; }
    .project-thread-path { stroke-width: 1.7px; }
    .project-thread-label { font-size: 13px; }
    /* The two top labels together are wider than a 354px stage, so they
       collided (E2EE and Sheet Store). Keep only the left one on mobile;
       the motif and the phase captions carry the story. */
    .visual-label--top-right { display: none; }
  }
</style>
