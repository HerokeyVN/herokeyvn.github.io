---
import type { Project } from "../data/portfolio";

interface Props { project: Project; }
const { project } = Astro.props;

// Round 9 rebuild: the round-8 motifs are deleted outright. Each project
// visual is now a meaningful story told through the red thread, per
// docs/storyboards-round-9.md (the design authority). The stage holds real
// DOM scenes (absolutely positioned, % of the stage so they track the SVG
// viewBox at any rendered width) plus one SVG overlay carrying the thread.
// All scene typography/spacing uses container query units (cqw) against the
// stage, so the DOM scenes scale with the stage exactly like the SVG does.
// The scroll drawing itself lives in src/scripts/project-threads.ts: one
// shared proxy `p` per project drives thread, DOM states, key/bar lighting
// and playhead together.

const r1 = (n: number) => Math.round(n * 10) / 10;

// Proper-crossing count between non-adjacent segments of a polyline.
// Build-time diagnostic for the small Signal-seal knot (target >= 2).
type Pt = { x: number; y: number };
const countCrossings = (pts: Pt[]) => {
  const orient = (a: Pt, b: Pt, c: Pt) =>
    Math.sign((b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x));
  let n = 0;
  for (let i = 0; i < pts.length - 1; i++) {
    for (let j = i + 2; j < pts.length - 1; j++) {
      if (i === 0 && j === pts.length - 2) continue;
      const a = pts[i]!;
      const b = pts[i + 1]!;
      const c = pts[j]!;
      const e = pts[j + 1]!;
      const o1 = orient(a, b, c);
      const o2 = orient(a, b, e);
      const o3 = orient(c, e, a);
      const o4 = orient(c, e, b);
      if (o1 !== o2 && o3 !== o4) n++;
    }
  }
  return n;
};

// Small dense knot: one period of a perturbed 3:2 Lissajous figure. Used
// ONLY as the Signal-seal element inside the E2EE story (the knot is no
// longer the motif). t runs pi/2..5pi/2 so the loop starts and ends at the
// leftmost point (cx-A, cy).
const knotPath = (cx: number, cy: number, A: number, B: number, A2: number, B2: number) => {
  const N = 240;
  const pts: Pt[] = [];
  for (let i = 0; i <= N; i++) {
    const t = Math.PI / 2 + (2 * Math.PI * i) / N;
    pts.push({
      x: r1(cx + A * Math.sin(3 * t) + A2 * Math.cos(7 * t)),
      y: r1(cy + B * Math.sin(2 * t) + B2 * Math.cos(5 * t)),
    });
  }
  let d = "";
  pts.forEach((p, i) => {
    d += (i === 0 ? `M ${p.x} ${p.y}` : ` L ${p.x} ${p.y}`);
  });
  return { d, crossings: countCrossings(pts) };
};

// Smooth curve through points (Catmull-Rom to Bezier). Used for the Sheet
// Store melody line through its timeline notes.
type MelodyNote = { x: number; y: number };
const melodyPath = (notes: MelodyNote[]) => {
  const first = notes[0]!;
  let d = `M ${first.x} ${first.y}`;
  for (let i = 0; i < notes.length - 1; i++) {
    const p0 = notes[Math.max(0, i - 1)]!;
    const p1 = notes[i]!;
    const p2 = notes[i + 1]!;
    const p3 = notes[Math.min(notes.length - 1, i + 2)]!;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${r1(c1x)} ${r1(c1y)}, ${r1(c2x)} ${r1(c2y)}, ${p2.x} ${p2.y}`;
  }
  return d;
};

// ---------------------------------------------------------------- E2EE
// Journey of an encrypted message. Desktop 900x560: Device A left, sealed
// envelope centre (Signal knot inside), Noise sleeve + relay right, Device B
// bottom-right. Mobile 560x560: the same journey stacked vertically, the
// sleeve running top-to-bottom.
const E2EE_KNOT = knotPath(450, 260, 55, 50, 8, 6);
const E2EE_KNOT_MOBILE = knotPath(280, 235, 80, 42, 6, 5);
console.log(`[motif] E2EE signal-seal knot crossings desktop=${E2EE_KNOT.crossings} mobile=${E2EE_KNOT_MOBILE.crossings}`);
const E2EE_D = `M 280 242 L 395 260 ${E2EE_KNOT.d.replace(/^M [\d.]+ [\d.]+/, "")} L 760 260 C 768 300, 765 340, 748 380`;
const E2EE_D_MOBILE = `M 185 110 C 185 160, 195 200, 200 235 ${E2EE_KNOT_MOBILE.d.replace(/^M [\d.]+ [\d.]+/, "")} L 280 300 L 280 428 C 280 450, 230 466, 185 466`;

// ------------------------------------------------------- Sky Sheet Store
// Faithful HTML presentation of the live site (verified from the research
// screenshots of skysheet.store, 2026-11-06). Only data read from those
// screenshots is shown; the fourth Trending card ("Ai Dua Em Ve") is
// omitted because its cover failed to load in the research render.
type SheetCard = {
  title: string; artist: string; transcribedBy?: string; uploadedBy: string;
  difficulty: "Hard" | "Insane"; tags: string[];
  bpm: number; notes: number; downloads: number; duration: string;
  lang?: string; tile: "teal" | "purple" | "navy"; featured?: boolean;
};
const SHEET_CARDS: SheetCard[] = [
  {
    title: "Tìm Em", artist: "Hngle Ft. Bảo Anh", transcribedBy: "DTomi",
    uploadedBy: "người lạ thoáng qua", difficulty: "Hard", tags: ["emotional"],
    bpm: 292, notes: 684, downloads: 41, duration: "3:51", lang: "VN",
    tile: "teal", featured: true,
  },
  {
    title: "truoc khi em ton tai", artist: "Anonymous", transcribedBy: "DEX",
    uploadedBy: "Toàn Nguyễn Phạm Dinh", difficulty: "Hard", tags: [],
    bpm: 520, notes: 345, downloads: 47, duration: "1:26", tile: "purple",
  },
  {
    title: "luu nien", artist: "Hakari",
    uploadedBy: "hakari", difficulty: "Insane", tags: [],
    bpm: 750, notes: 953, downloads: 42, duration: "3:08", tile: "navy",
  },
];
const SHEET_STATS = [
  { value: "292", label: "BPM" },
  { value: "3:51", label: "Duration" },
  { value: "684", label: "Note Count" },
  { value: "2.96", label: "Notes/Sec" },
  { value: "15/15", label: "Unique Keys" },
  { value: "89", label: "Chord Count" },
];
// Original 8-note practice phrase (times in seconds, keys 0-14). Ends on
// key 14, the bottom-right key of the grid, where the thread exits.
const SHEET_PHRASE = [
  { time: 0, key: 0 }, { time: 1, key: 2 }, { time: 2, key: 4 },
  { time: 3, key: 7 }, { time: 4, key: 9 }, { time: 5, key: 11 },
  { time: 6, key: 12 }, { time: 7, key: 14 },
];
const SHEET_NOTES: MelodyNote[] = SHEET_PHRASE.map((note) => ({
  x: r1(120 + (note.time / 7) * 1200),
  y: r1(170 - (note.key / 14) * 60),
}));
const SHEET_NOTES_MOBILE: MelodyNote[] = SHEET_PHRASE.map((note) => ({
  x: r1(30 + (note.time / 7) * 500),
  y: r1(150 - (note.key / 14) * 40),
}));
const SHEET_MELODY = melodyPath(SHEET_NOTES).replace(/^M [\d.]+ [\d.]+/, "");
const SHEET_MELODY_MOBILE = melodyPath(SHEET_NOTES_MOBILE).replace(/^M [\d.]+ [\d.]+/, "");
const SHEET_D_BROWSE = `M 10 175 L 258 175`;
const SHEET_D_DETAIL = `M 258 175 C 280 260, 340 330, 400 355 C 490 300, 620 200, 730 185 C 800 175, 860 182, 900 212`;
// Fix round: the old route looped around the stats strip, and the loop's
// corner grazed the stat values (a practice dot sat on "2.96"). The thread
// now runs UNDER the stats strip, in the clear gap between the strip and
// the rail, and dips into Open Player. No loop, no text crossed.
const SHEET_D_PRACTICE = `M 120 170${SHEET_MELODY} C 1320 250, 1200 380, 1070 470`;
const SHEET_D_MOBILE_BROWSE = `M 8 105 L 71 105`;
const SHEET_D_MOBILE_DETAIL = `M 71 105 C 90 130, 200 120, 280 116 C 370 150, 460 200, 500 260 C 520 295, 480 325, 426 347`;
// Fix round: the old mobile route looped a rectangle around the stats
// block, so at mid scrub its visible end sat beside Share Sheet instead of
// pointing at Open Player. The thread now sweeps from the play button
// straight to the centre of Open Player.
const SHEET_D_MOBILE_PRACTICE = `M 30 150${SHEET_MELODY_MOBILE} C 548 220, 548 380, 540 481`;

// --------------------------------------------------------- Sky Auto Piano
// Original 8-note sequence using ONLY the two note-to-key mappings verified
// in the storyboard (1Key3 -> H, 1Key7 -> L). One chord (H+L at 4.5s), one
// sustained note (L, 6.0-8.5s). Total 12s. The bars carry their timing as
// data attributes so the script reads the same numbers the markup shows.
type PianoNote = { start: number; end: number; pkey: "H" | "L"; lane: 0 | 1 };
const PIANO_NOTES: PianoNote[] = [
  { start: 0.0, end: 0.5, pkey: "H", lane: 0 },
  { start: 1.5, end: 2.0, pkey: "L", lane: 1 },
  { start: 3.0, end: 3.5, pkey: "H", lane: 0 },
  { start: 4.5, end: 5.0, pkey: "H", lane: 0 },
  { start: 4.5, end: 5.0, pkey: "L", lane: 1 },
  { start: 6.0, end: 8.5, pkey: "L", lane: 1 },
  { start: 9.0, end: 9.5, pkey: "H", lane: 0 },
  { start: 10.5, end: 11.0, pkey: "L", lane: 1 },
];
const PIANO_KEYS = ["Y", "U", "I", "O", "P", "H", "J", "K", "L", ";", "N", "M", ",", ".", "/"];
const PIANO_D = "M 300 72 C 265 118, 200 145, 130 158 C 80 166, 30 172, 22 195 C 16 220, 20 250, 35 262 L 60 265";
// Fix round: the old entry bent right too early and grazed the timeline
// label (2.9px from its top-left corner on desktop, 1.3px on mobile). The
// descent now stays tight to the left edge until it is level with the H
// lane, then runs right to the first bar, below the label.
const PIANO_D_MOBILE = "M 60 110 C 48 132, 28 142, 12 158 C 7 172, 6 195, 6 215 C 6 232, 15 240, 30 244";
const PIANO_EXIT_D = "M 840 280 C 800 350, 720 420, 660 448 C 620 458, 560 460, 538 482";
// Fix round: the old exit dropped straight down the right edge, then swept
// back left across the footer strip. It now runs diagonally to the L key,
// passing below the footer and the "0:12" tick, and approaches L along the
// keyboard row gap.
const PIANO_EXIT_D_MOBILE = "M 530 245 C 515 275, 500 295, 488 318 C 480 340, 475 365, 470 392 C 460 420, 445 445, 430 458 C 415 462, 395 470, 384 482";
// Fix round (mobile): same tidy-up - the exit crosses the tick row in the
// gap between "0:09" and "0:12", stays right of the footer, and approaches
// the L key along the row gap instead of sweeping across the footer strip.
