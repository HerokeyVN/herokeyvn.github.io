      <span class="piano-giant" aria-hidden="true"><span class="piano-giant__row piano-giant__row--solid">Y U I O P</span><span class="piano-giant__row piano-giant__row--outline">H J K L ;</span><span class="piano-giant__row piano-giant__row--dim">N M , . /</span></span>
    </div>

    <div class="layer layer--mid" data-layer="mid">
      <span class="piano-rail piano-rail--left" data-el="piano-rail-left" aria-hidden="true"></span>
      <span class="piano-rail piano-rail--right" data-el="piano-rail-right" aria-hidden="true"></span>
