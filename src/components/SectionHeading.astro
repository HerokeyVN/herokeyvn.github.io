---
interface Props {
  id: string;
  index: string;
  eyebrow: string;
  title: string;
  italicWord?: string;
  // Round 12: when true, the italic (outlined) word is split into per-char
  // spans so the site thread can trace its outlines like the About glyphs.
  // Only the Experience heading sets this; other headings are untouched.
  traceItalic?: boolean;
}

const { id, index, eyebrow, title, italicWord, traceItalic } = Astro.props;
---

<header class="section-heading" data-reveal data-display-heading>
  <div class="section-heading__meta">
    <span class="meta-badge">{index}</span>
    <span class="meta-line" aria-hidden="true"></span>
    <span class="meta-eyebrow">{eyebrow}</span>
  </div>
  <h2 id={id} class="section-heading__title">
    {title}
    {italicWord && (
      <em>
        {" "}
        {traceItalic ? (
          italicWord
            .trim()
            .split(" ")
            .map((word, wordIndex) => (
              <>
                <span class="exp__trace-word" data-exp-glyph-word={wordIndex}>
                  {[...word.toUpperCase()].map((char, charIndex) => (
                    <span class="exp__glyph" data-exp-glyph-key={`exp-${wordIndex}-${charIndex}`} data-exp-glyph-char={char}>{char}</span>
                  ))}
                  <span class="exp__glyph-baseline" data-exp-glyph-baseline={wordIndex} aria-hidden="true"></span>
                </span>
                {wordIndex < italicWord.trim().split(" ").length - 1 && " "}
              </>
            ))
        ) : (
          italicWord
        )}
      </em>
    )}
  </h2>
</header>

<style>
  .section-heading { position: relative; display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: clamp(3.5rem, 8vw, 8rem); }

  .section-heading__meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .meta-badge {
    color: var(--accent-red);
    font-weight: 500;
  }

  .meta-line {
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--accent-red);
    opacity: 0.6;
  }

  .meta-eyebrow {
    color: var(--text-secondary);
  }

  .section-heading__title {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7.7vw, 7.5rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.065em;
    color: var(--text-primary);
    max-width: 72rem;
    text-transform: uppercase;
  }

  .section-heading__title em {
    font-family: inherit;
    font-style: normal;
    font-weight: inherit;
    color: transparent;
    -webkit-text-stroke: 1px rgba(239, 237, 230, 0.55);
  }

  .exp__trace-word { white-space: nowrap; }
  .exp__glyph { display: inline; }
  .exp__glyph-baseline { display: inline-block; width: 0; height: 0; overflow: hidden; line-height: 0; vertical-align: baseline; }

  @media (max-width: 768px) {
    .section-heading {
      padding-right: 2rem;
    }

    .section-heading__title em { display: block; }
  }
</style>
